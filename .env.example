DATABASE_URL=postgres://kalisthenos:kalisthenos@localhost:5432/kalisthenos
SESSION_SECRET=replace-me-with-32-or-more-bytes-of-random-base64-here
FILE_SIGNING_SECRET=replace-me-with-32-or-more-bytes-of-random-base64-here
BASE_URL=http://localhost:3000
DATA_DIR=./data
MAX_UPLOAD_BYTES=250000000
NODE_ENV=development

# Bootstrap trainer account (used only by `npm run db:seed` on an empty users table).
# In production, set a strong password — first login should change it.
SEED_TRAINER_EMAIL=trener@example.com
SEED_TRAINER_PASSWORD=replace-me-strong-password
SEED_TRAINER_NAME=Imię Nazwisko

# Bootstrap tenancy marki (używane TYLKO przez scripts/seed.ts; aplikacja działa bez nich).
# Tworzy organizację, regiony PL i FR oraz konto brand_admin; idempotentne (bezpieczne do ponownego uruchomienia).
BRAND_NAME=
BRAND_ADMIN_EMAIL=
BRAND_ADMIN_PASSWORD=
# opcjonalne; domyślnie = BRAND_NAME
BRAND_ADMIN_NAME=

# --- Integracja Google Calendar / Meet (OPCJONALNA) ---
# Pozostaw puste, aby wyłączyć integrację (aplikacja działa bez Google).
# Utwórz projekt w Google Cloud Console → OAuth consent screen (External) +
# OAuth client (Web application). Scope: https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/trener/integracje/google/callback
# Klucz AES-256-GCM, base64 z 32 losowych bajtów:  openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=

# Płatności Stripe (opcjonalne). Klucz platformy + sekrety podpisu webhooków.
# Lokalnie webhook: `stripe listen --forward-to localhost:3000/webhooks/stripe`
# (sekret z outputu `stripe listen` wpisz do STRIPE_WEBHOOK_SECRET).
# Prod: dwa event destinations na ten sam URL /webhooks/stripe —
#   STRIPE_WEBHOOK_SECRET          → destination scope „Your account" (billing)
#   STRIPE_CONNECT_WEBHOOK_SECRET  → destination scope „Connected accounts" (account.updated)
# verifyAndParse próbuje oba sekrety; wystarczy ustawić te, których używasz.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
